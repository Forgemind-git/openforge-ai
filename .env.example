# ─────────────────────────────────────────────────────────────────────────────
# Open Forge AI — server settings. Copy to .env and adjust.
#
# There are NO third-party credentials in this file on purpose. Every user
# enters their own OpenAI / Anthropic / Gemini / Google / WhatsApp / Telegram
# keys on the Settings page; they are stored encrypted in the database.
# ─────────────────────────────────────────────────────────────────────────────

# The public address people open (no trailing slash). Used to build the Google
# OAuth redirect URI and the WhatsApp / Telegram webhook URLs. Webhooks need a
# public HTTPS address — Meta and Telegram cannot reach localhost.
PUBLIC_URL=http://localhost:3000

# Port published on the host (docker-compose.yml only).
OPENFORGE_PORT=3000

# Optional. Leave blank and a random secret is generated on first boot and kept
# in the data volume. Set them to pin the values (e.g. when running more than one
# container). CHANGING ENCRYPTION_KEY LATER MAKES SAVED KEYS UNREADABLE.
SESSION_SECRET=
ENCRYPTION_KEY=

# Optional DEMO login — OFF unless both are set. Creates this account at boot and
# SHOWS the email + password on the sign-in page. Only for a public demo install;
# leave blank for real use (the first visitor then creates the admin account).
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# Only for docker-compose.traefik.yml
OPENFORGE_HOST=openforge.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
